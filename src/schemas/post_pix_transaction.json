{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pix Transaction",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 255
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "transaction_date": {
      "type": "string",
      "format": "date-time"
    },
    "source_account": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "account_number": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "opening_date": {
          "type": "string",
          "format": "date-time"
        },
        "owner": {
          "type": "object",
          "properties": {
            "document_number": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "document_number"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "branch",
        "account_number",
        "opening_date",
        "owner"
      ],
      "additionalProperties": false
    },
    "destination_account": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "account_number": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "opening_date": {
          "type": "string",
          "format": "date-time"
        },
        "owner": {
          "type": "object",
          "properties": {
            "document_number": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "document_number"
          ],
          "additionalProperties": false
        },
        "participant": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        }
      },
      "required": [
        "branch",
        "account_number",
        "opening_date",
        "owner",
        "participant"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "ip": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "geolocation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "latitude",
            "longitude"
          ]
        }
      },
      "required": [
        "device_id",
        "channel",
        "ip"
      ]
    },
    "limit_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "period": {
          "enum": [
            "day",
            "night"
          ]
        },
        "limit_amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "used_amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "period",
        "limit_amount",
        "used_amount"
      ]
    }
  },
  "required": [
    "id",
    "amount",
    "transaction_date",
    "source_account",
    "destination_account",
    "source"
  ]
}
